# App
# development or production
MODE=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
# in seconds
TRAFFIC_JOB_INTERVAL=120

# Logger
# plain (default) | json
CONSOLE_LOG_FORMAT=plain
LOG_PATH=.logs/mwp.log
# in days
LOG_MAX_AGE=30

# DB
DB_HOST=127.0.0.1
# postgres | sqlite
DB_DIALECT=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mwp_db

# Server
SERVER_COMMENT="MWP Server"
SERVER_NAME="Local Server"
SERVER_IP_ADDRESS=192.168.64.2
SERVER_API_PORT=80
SERVER_USERNAME=admin
SERVER_PASSWORD=admin

# Admin
# Set ADMIN_PASSWORD explicitly for a real deployment -- if left unset (or
# removed from this file), a random password is generated on first boot
# and printed once to the server log/console instead of falling back to a
# fixed, guessable default.
ADMIN_USERNAME=ApexPanel
ADMIN_PASSWORD=

# Auth
# in seconds
AUTH_ACCESS_TOKEN_TTL=900
# in seconds
AUTH_REFRESH_TOKEN_TTL=86400

# Telegram
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Faoxima (bot-as-a-service) -- default Telegram proxy for new instances.
# Leave blank for a direct connection (the common case). If your server's
# network blocks direct access to api.telegram.org, set this to a SOCKS5
# proxy you control, e.g. socks5h://user:pass@proxy.example.com:1080 --
# a domain name registered through a provider like Cloudflare (rather
# than a bare IP) is recommended, so the proxy can be repointed to a new
# IP later without reconfiguring every already-provisioned instance.
FAOXIMA_DEFAULT_TELEGRAM_PROXY=

# License (see D:\license-panel for the central license/update server)
#
# The license key you were issued -- only needed once, on first activation
# (either via this env var + a restart, or the web UI's activation page);
# after that MWPanel stores it in the database and this var can be removed.
LICENSE_KEY=
# The Ed25519 public key license-panel signs its responses with. You do
# NOT need to fill this in by hand: if left blank, MWPanel automatically
# fetches it from the license server's own unauthenticated
# /api/v1/license/public-key endpoint on first activation and caches it in
# the database, so future restarts never need network access for this.
# Only set this explicitly if you want to pin a specific key without
# trusting the auto-fetch (e.g. an air-gapped install) -- if set, this
# value always wins over whatever the server would otherwise hand back.
LICENSE_PUBLIC_KEY=
# in seconds
LICENSE_CHECK_INTERVAL_SECONDS=3600
# The license server's address. Only takes effect on this install's very
# FIRST activation -- once activated, whatever URL was actually used gets
# locked into the database and this var is ignored on every later
# restart, even if you change it here (see licenseServerBaseURLDefault's
# doc comment in api/config/config.go for why: this stops anyone who
# later gets .env access from silently redirecting an already-activated
# install to a different license server). Leave blank to use the
# built-in default. Port 3131 is the public API -- NOT 3132 (the
# JWT-protected admin API/UI; pointing here fails every call with "401
# missing or malformed jwt"), e.g.
# LICENSE_SERVER_URL=http://203.0.113.10:3131
LICENSE_SERVER_URL=
